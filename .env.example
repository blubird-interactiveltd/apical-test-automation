# Apical front-end under test (the running Vue app)
BASE_URL=
# API origin the front-end calls (VITE_BASE_URL_DEV / VITE_BASE_URL_PROD of that build)
API_URL=
# Tenant sub-domain; sent as X-Tenant: https://<ORGANIZATION>.apical.io
ORGANIZATION=

# Master (Super Admin) account — required
MASTER_EMAIL=
MASTER_PASSWORD=

# Coaching Center account — optional; view-only and tenant-isolation cases skip without it
COACHING_EMAIL=
COACHING_PASSWORD=

# Teacher account — optional; teacher-route regression cases skip without it
TEACHER_EMAIL=
TEACHER_PASSWORD=

# "1" runs the read-only backend checks that assume the AP-779 sample dataset exists
RUN_LIVE=0
