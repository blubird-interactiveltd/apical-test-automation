{
  "name": "apical-test-automation",
  "version": "1.0.0",
  "description": "Playwright Test Automation Framework for Apical",
  "main": "index.js",
  "scripts": {
    "test": "npx playwright test --pass-with-no-tests --workers=6",
    "test:chromium": "npx playwright test --pass-with-no-tests --project=chromium --workers=6",
    "test:firefox": "npx playwright test --pass-with-no-tests --project=firefox --workers=6",
    "test:webkit": "npx playwright test --pass-with-no-tests --project=webkit --workers=6",
    "test:regular": "cross-env RUN_TYPE=regular npx playwright test --pass-with-no-tests --workers=6",
    "test:edge": "cross-env RUN_TYPE=edge npx playwright test --pass-with-no-tests --workers=6",
    "test:all": "npm-run-all --parallel test:chromium test:firefox test:webkit",
    "test:id": "npx playwright test --pass-with-no-tests -g",
    "test:smoke": "npx playwright test --pass-with-no-tests tests/e2e/smoke --workers=6",
    "test:regression": "npx playwright test --pass-with-no-tests tests/e2e/regression --workers=6",
    "test:online-class": "npx playwright test --pass-with-no-tests --project=chromium tests/tickets/AP-779-online-class-list",
    "test:course": "npx playwright test --pass-with-no-tests --project=chromium tests/tickets/AP-781-course-create",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^17.3.1",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "semver": ">=5.7.2",
    "brace-expansion": ">=1.1.13"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@biomejs/biome": "2.5.11",
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.3.0",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "@vitest/coverage-v8": "^4.1.9",
    "cross-env": "^10.1.0",
    "eslint": "^10.3.0",
    "madge": "^8.0.0",
    "npm-run-all": "^4.1.5",
    "prettier": "3.8.3",
    "vitest": "^4.1.9"
  }
}
